ENVIRONMENT="development"

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=skill_tracker_db

# Async Database URL for SQLAlchemy 2.0 (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:your_local_password@localhost:5432/skill_tracker_db

# APIs
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""